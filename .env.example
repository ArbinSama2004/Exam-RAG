# Copy to .env and adjust if needed. The defaults work for local Docker Compose.

# --- Application ---
APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Ports published on the host ---
API_PORT=8000
FRONTEND_PORT=3000

# --- PostgreSQL (with pgvector) ---
POSTGRES_USER=examrag
POSTGRES_PASSWORD=examrag
POSTGRES_DB=examrag
POSTGRES_PORT=5432
# Host used by the backend. "postgres" inside Docker Compose, "localhost" when
# running the backend directly on your machine.
POSTGRES_HOST=postgres

# --- Storage ---
# Container path for uploaded files; bind-mounted to ./data/uploads on the host.
UPLOAD_DIR=/data/uploads
# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=50

# --- Retrieval tuning (adjustable during evaluation) ---
VECTOR_CANDIDATES=30
KEYWORD_CANDIDATES=30
FUSED_CANDIDATES=30
RERANKER_CANDIDATES=20
FINAL_CONTEXT_CHUNKS=6

# --- LLM (through Ollama on the host) ---
# Inside Docker Compose the backend reaches the host with host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# A "-cloud" model is proxied by Ollama to ollama.com, so prompts (including
# the retrieved passages from your documents) leave this machine. Swap in a
# pulled local model to keep everything local:
#   ollama pull llama3.1:8b   then   OLLAMA_MODEL=llama3.1:8b
OLLAMA_MODEL=gpt-oss:20b-cloud
LLM_TEMPERATURE=0.2
LLM_CONTEXT_TOKENS=8192
LLM_TIMEOUT_SECONDS=180

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
